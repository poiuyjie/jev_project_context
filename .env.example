# TypeSafe Jev API key — get one at https://console.typesafe.ai/keys
#
# Copy this file to `.env` (same directory) and paste your key below.
# `.env` is git-ignored; never commit a real key.
#
# TYPESAFE_API_KEY=apikey_xxxxxxxxxxxx
#
# Optional overrides:
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1/systemone
